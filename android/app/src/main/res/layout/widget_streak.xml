<?xml version="1.0" encoding="utf-8"?>
<!-- ★【0.04.18】ホーム画面のウィジェット：連続記録・今日の状態・週間プランの次の課題 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/w_fire" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥" android:textSize="30sp" />
        <TextView android:id="@+id/w_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:text="0" android:textSize="34sp" android:textStyle="bold" android:textColor="#FFB020" />
        <TextView android:id="@+id/w_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:text="日連続" android:textSize="13sp" android:textColor="#C9D1E0" />
    </LinearLayout>

    <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="今日1問解いて記録をはじめよう" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#E8EDF5" android:maxLines="2" android:ellipsize="end" />

    <TextView android:id="@+id/w_plan" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="" android:textSize="12sp" android:textColor="#9AA6BC"
        android:maxLines="2" android:ellipsize="end" />

    <TextView android:id="@+id/w_foot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="すするanki" android:textSize="10sp" android:textColor="#5E6B82" />
</LinearLayout>
