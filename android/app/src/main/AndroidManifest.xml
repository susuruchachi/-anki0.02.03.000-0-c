<?xml version="1.0" encoding="utf-8"?>
<!-- ★【0.04.03】WebView 版：Chrome を使わず、Android の内蔵部品でウェブ版を表示する（MainActivity.java） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 新しい APK を、アプリの中から上書きインストールする（初めてのときだけ「この提供元のアプリを許可」を聞かれる） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcherName"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 通知やリンクから、すするanki のページを開いたとき -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/hostName" android:pathPrefix="@string/pathPrefix" />
            </intent-filter>
        </activity>
        <!-- ★【0.04.18】ホーム画面のウィジェット（連続記録・週間プランの次の課題） -->
        <receiver android:name=".StreakWidget" android:exported="false" android:label="@string/widgetName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_streak_info" />
        </receiver>
        <!-- ★【0.04.24】アプリの自動更新（入れた結果・閉じて1分後に起こす） -->
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <!-- ★【0.04.19】大きいウィジェット（フレンドとのランキング・自分の進み具合） -->
        <receiver android:name=".BoardWidget" android:exported="false" android:label="@string/boardName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_board_info" />
        </receiver>

        <!-- ★【0.04.12】アプリの中のブラウザ（チャットなどのリンクを開く） -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
